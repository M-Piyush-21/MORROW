      "unit": "Units per Day",
      "retail_meaning": "Penalizes large outlier misses much more heavily than MAE. Essential for identifying sudden demand surges (promotions, viral spikes) that risk rapid stockouts."
    },
    "wape": {
      "name": "Weighted Absolute Percentage Error (WAPE)",
      "unit": "Percentage (%)",
      "retail_meaning": "Total absolute forecast errors divided by total catalog demand volume. Unlike MAPE, WAPE does not explode or divide by zero on slow-moving or quiet sales days."
