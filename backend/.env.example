# Backend Environment Configuration
ENVIRONMENT=development
API_V1_PREFIX=/api
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ML & Models
MODEL_PATH=backend/models/random_forest_demand.joblib
MODEL_METADATA_PATH=backend/models/model_metadata.json
PROCESSED_DATA_PATH=backend/data/processed/daily_demand.parquet
EVALUATION_METRICS_PATH=backend/reports/metrics/evaluation_metrics.json
MODEL_COMPARISON_PATH=backend/reports/metrics/model_comparison.json

# MLflow
MLFLOW_TRACKING_URI=sqlite:///mlruns.db
MLFLOW_EXPERIMENT_NAME=morrow_demand_forecasting
