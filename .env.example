# ==============================================================================
# MORROW Demand Forecasting & Inventory Intelligence Platform - Environment Config
# ==============================================================================

# --- Frontend (Vite / React) ---
VITE_API_BASE_URL=http://localhost:8000/api
VITE_DEMO_MODE=true

# --- Backend Application ---
ENVIRONMENT=development
PROJECT_NAME="Morrow Demand Forecasting & Inventory Intelligence API"
VERSION=1.0.0
API_V1_PREFIX=/api
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","*"]

# --- MLflow Experiment Tracking & Registry ---
MLFLOW_TRACKING_URI=sqlite:///mlruns.db
MLFLOW_EXPERIMENT_NAME=morrow_demand_forecasting
MLFLOW_REGISTRY_MODEL_NAME=morrow_demand_forecasting_model

# --- Model & Data Artifact Paths (Defaults resolve to repository root) ---
# MODEL_PATH=backend/models/random_forest_demand.joblib
# MODEL_METADATA_PATH=backend/models/model_metadata.json
# PROCESSED_DATA_PATH=backend/data/processed/daily_demand.parquet
# EVALUATION_METRICS_PATH=backend/reports/metrics/evaluation_metrics.json
# MODEL_COMPARISON_PATH=backend/reports/metrics/model_comparison.json
# PROMOTION_DECISION_PATH=backend/reports/metrics/promotion_decision.json
# ACTIVE_ALERTS_PATH=backend/reports/metrics/active_alerts.json
# FEEDBACK_LOG_PATH=backend/data/feedback/forecast_feedback.jsonl

# --- Operational Server Configuration ---
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=info
