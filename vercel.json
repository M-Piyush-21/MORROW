{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,docs/**,backend/tests/**,backend/reports/figures/**,src/**,dist/**,*.md,*.lock,*.yaml,dvc.*,start.sh,Dockerfile*}"
    },
    "api/*.py": {
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,docs/**,backend/tests/**,backend/reports/figures/**,src/**,dist/**,*.md,*.lock,*.yaml,dvc.*,start.sh,Dockerfile*}"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
